# ==========================================
# DEPENDENCIES
# ==========================================
node_modules/
**/node_modules/
**/node_modules/**

# ==========================================
# ENVIRONMENT VARIABLES & SECRETS
# ==========================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
**/.env.local

# Allow example/template files
!.env.example
!.env.sample
!**/.env.example
!**/.env.sample

# Firebase & Cloud Service Credentials
serviceAccountKey.json
**/serviceAccountKey.json
*serviceAccountKey*.json

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# ==========================================
# BUILD OUTPUTS
# ==========================================
dist/
build/
coverage/
.next/
out/

# ==========================================
# LOG FILES
# ==========================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==========================================
# TEMPORARY & OS FILES
# ==========================================
tmp/
temp/
*.tmp
*.bak
.DS_Store
Thumbs.db

# ==========================================
# IDE & EDITOR FILES
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# TEST & CACHE FILES
# ==========================================
.cache/
.parcel-cache/
.eslintcache
